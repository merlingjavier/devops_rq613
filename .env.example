# Keycloak local. Use values only for this development environment.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-password
COREBANK_TARIFARIO_CLIENT_SECRET=replace-with-corebank-tarifario-client-secret

# SQL Server usado por Creditos en Desarrollo.
SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=CoreBank;User ID=<database-user>;Password=<database-password>;TrustServerCertificate=True

# Colecciones de configuracion para Discount Pricing.
MONGO_QUERY_DB_NAME=discountpricing
MONGO_MAINTENANCE_DB_NAME=discountpricing

# Topico de trazabilidad de Product Pricing.
KAFKA_TOPIC=product-pricing-traces
