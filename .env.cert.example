# SQL Server certificado. DB_USER y DB_PASSWORD deben estar cifrados por crypto-generator.
DB_SERVER=host.docker.internal,1433
DB_NAME=CoreBank
DB_USER=<encrypted-database-user>
DB_PASSWORD=<encrypted-database-password>
PRODUCTOS_OFERTAS=
PRODUCTOS_REENGANCHE=

# Servicios publicados temporalmente por certificacion.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
PRODUCT_PRICING_X_PUBLIC_URL=http://localhost:8003

# Sentinel no se utiliza en certificacion, pero Creditos requiere estas variables al iniciar en Production.
SENTINEL_RESOURSE_URL=http://sentinel-disabled.invalid
SENTINEL_KEYCLOAK_AUTH_URL=http://sentinel-disabled.invalid
SENTINEL_KEYCLOAK_AUTH_CLIENT=<encrypted-disabled-client>
SENTINEL_KEYCLOAK_AUTH_CLIENT_SECRET=<encrypted-disabled-secret>
SENTINEL_KEYCLOAK_AUTH_GRANT_TYPE=client_credentials
SENTINEL_KEYCLOAK_AUTH_SCOPE=api/r:snt api/w:snt
SENTINEL_RESPONSE_TIMEOUT_SECONDS=10

# MongoDB.
MONGO_ROOT_USERNAME=replace-with-mongo-admin
MONGO_ROOT_PASSWORD=replace-with-mongo-admin-password
MONGO_HOST=host.docker.internal:27017
MONGO_QUERY_DB_NAME=discountpricing
MONGO_QUERY_DB_USER=discount-pricing-query
MONGO_QUERY_DB_PASSWORD=discount-pricing-query-password
MONGO_MAINTENANCE_DB_NAME=discountpricing
MONGO_MAINTENANCE_DB_USER=discount-pricing-maintenance
MONGO_MAINTENANCE_DB_PASSWORD=discount-pricing-maintenance-password
MONGO_TRACE_DB_USER=product-pricing-trace-writer
MONGO_TRACE_DB_PASSWORD=product-pricing-trace-writer-password
MONGO_TRACE_CONNECTION_STRING=mongodb://product-pricing-trace-writer:product-pricing-trace-writer-password@host.docker.internal:27017/SI_DBApibusEventHistory?authSource=admin

# Keycloak.
KEYCLOAK_ADMIN_USERNAME=replace-with-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-password
COREBANK_TARIFARIO_CLIENT_SECRET=replace-with-corebank-tarifario-client-secret
KEYCLOAK_DB_PASSWORD=replace-with-keycloak-database-password

# Kafka.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC=product-pricing-traces
