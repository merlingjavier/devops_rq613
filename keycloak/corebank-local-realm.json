{
  "realm": "corebank-local",
  "enabled": true,
  "clients": [
    {
      "clientId": "corebank-tarifario",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "product-pricing-x"
      ]
    },
    {
      "clientId": "product-pricing-x",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "clientScopes": [
    {
      "name": "product-pricing-x",
      "description": "Access to ProductPricingX",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "product-pricing-x audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "product-pricing-x",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
