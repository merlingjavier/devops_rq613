{
  "Jwt": {
    "Issuer": "http://localhost:8081/realms/corebank-local",
    "MetadataAddress": "http://keycloak:8080/realms/corebank-local/.well-known/openid-configuration",
    "JwksAddress": "http://keycloak:8080/realms/corebank-local/protocol/openid-connect/certs",
    "Audience": "product-pricing-x"
  },
  "ReverseProxy": {
    "Routes": {
      "product-pricing-b": {
        "ClusterId": "product-pricing-b",
        "AuthorizationPolicy": "pricing-access",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderRemove": "Authorization"
          }
        ]
      }
    },
    "Clusters": {
      "product-pricing-b": {
        "Destinations": {
          "primary": {
            "Address": "http://product-pricing-b:80/"
          }
        }
      }
    }
  }
}
